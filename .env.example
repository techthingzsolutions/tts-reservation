# Copy to .env and adjust. Never commit .env (blueprint 6.5).

# Laravel API base URL. The frontend never talks to anything else.
VITE_API_URL=http://localhost:8000/api

# Mock API (MSW). Set to "false" once the Laravel API is running.
# While true, every request is served from src/mocks/ with seeded data.
VITE_USE_MOCK_API=true

# Tenant resolution during local development.
# In production the tenant comes from the subdomain (blueprint 5.x white label).
VITE_DEFAULT_TENANT_SLUG=demo-salon

# Sentry DSN - leave empty locally (blueprint 6.3 monitoring)
VITE_SENTRY_DSN=
