# Committed on purpose: a fresh clone should run with `npm install && npm run dev`
# and no setup. Contains no secrets.
#
# To point at a real Laravel API instead, create `.env.local` (gitignored) with
# VITE_USE_MOCK_API=false and your own VITE_API_URL.

VITE_API_URL=http://localhost:8000/api
VITE_USE_MOCK_API=true
VITE_DEFAULT_TENANT_SLUG=demo-salon
